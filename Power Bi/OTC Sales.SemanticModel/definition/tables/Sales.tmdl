table Sales
	lineageTag: 3da2ad92-e26e-5bf6-a7bf-14c6380dfb22

	measure Revenue = SUM(Sales[Amount])
		formatString: $#,0.00;($#,0.00);$0.00
		lineageTag: b5b2d12e-7781-5acb-9542-689569f403f3

	measure Orders = COUNTROWS(Sales)
		formatString: #,0
		lineageTag: d793daac-50ad-5d3e-9997-37f600988856

	measure 'Boxes shipped' = SUM(Sales[Boxes])
		formatString: #,0
		lineageTag: 73daf6b5-f685-5d67-ac31-c29115c85755

	measure 'Average order value' = DIVIDE([Revenue], [Orders])
		formatString: $#,0.00
		lineageTag: 14f5146e-708f-5b92-944c-ecdf3ad51832

	measure 'Revenue per box' = DIVIDE([Revenue], [Boxes shipped])
		formatString: $#,0.00
		lineageTag: bf80811c-5581-50bc-954b-0c4374737b88

	measure 'Distinct products' = DISTINCTCOUNT(Sales[Product])
		formatString: #,0
		lineageTag: 7f8bbf48-72ea-5561-83bc-d7e1ccbc8da0

	column 'Sale ID'
		dataType: int64
		isKey
		lineageTag: 063c5bb0-da2d-56f4-8454-579c3dbe2b40
		summarizeBy: none
		sourceColumn: sale_id

	column 'Sale date'
		dataType: dateTime
		formatString: dd MMM yyyy
		lineageTag: 53c623f0-362e-52ea-9bc5-9c9926b445f8
		summarizeBy: none
		sourceColumn: sale_date

		annotation UnderlyingDateTimeDataType = Date

	column Product
		dataType: string
		lineageTag: f8803aa9-1a37-56e2-8722-8c7a52707ba4
		summarizeBy: none
		sourceColumn: product

	column 'Sales rep'
		dataType: string
		lineageTag: e21a93a5-3b49-5f8c-9265-03634967d14a
		summarizeBy: none
		sourceColumn: sales_person

	column Boxes
		dataType: int64
		lineageTag: 4c16e580-f249-5d2d-8791-f90ebd4f525a
		summarizeBy: none
		sourceColumn: boxes_shipped

	column Amount
		dataType: decimal
		formatString: $#,0.00
		lineageTag: 1f5d91d9-b319-5e81-8a3b-6bebf86d1854
		summarizeBy: none
		sourceColumn: amount_usd

	column Country
		dataType: string
		lineageTag: 48d4d406-6766-5252-a7e4-a64771f6e63d
		summarizeBy: none
		sourceColumn: country

	column Month
		dataType: string
		lineageTag: 46584c45-44e9-5792-925f-3228b3a5d785
		summarizeBy: none
		sourceColumn: month_label
		sortByColumn: 'Month start'

	column 'Month start'
		dataType: dateTime
		isHidden
		formatString: dd MMM yyyy
		lineageTag: 1b194332-df4d-5aee-8b66-031e56b021ee
		summarizeBy: none
		sourceColumn: month_start

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: string
		lineageTag: d3769d08-0e68-4081-9ae1-2efc4f718da6
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column 'month 2'
		dataType: string
		lineageTag: 027768a2-cead-4788-8743-0ac2a3001daf
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = Automatic

	column deal_size_category
		dataType: string
		lineageTag: 541d55e7-dea3-4981-9af4-ea1b0a0626d3
		summarizeBy: none
		sourceColumn: deal_size_category

		annotation SummarizationSetBy = Automatic

	partition Sales = m
		mode: import
		source =
				let
				    Input = if SalesCsvPath = null or Text.Trim(SalesCsvPath) = "" then
				        Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip)
				        else File.Contents(SalesCsvPath),
				    Csv = Csv.Document(Input, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),
				    Dates = Table.TransformColumnTypes(Headers, {{"sale_id", Int64.Type}, {"sale_date", type date}, {"boxes_shipped", Int64.Type}, {"amount_usd", Currency.Type}, {"product", type text}, {"sales_person", type text}, {"country", type text}, {"month_label", type text}}, "en-US"),
				    Result = Table.AddColumn(Dates, "month_start", each Date.StartOfMonth([sale_date]), type date)
				in
				    Result

	annotation PBI_ResultType = Table

